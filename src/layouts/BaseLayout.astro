---
import { profile, siteUrl } from '../data/profile';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;

const ogImage = new URL('og.png', siteUrl).href;

// Person em JSON-LD: é a marcação natural de um perfil pessoal e é o que permite
// ao Google ligar este site aos perfis externos em vez de os tratar como links soltos.
// Só entra aqui o que os dados do perfil declaram, para não afirmar nada que a página não diga.
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.fullName,
  alternateName: profile.name,
  description: profile.bio,
  url: siteUrl.href,
  image: new URL(profile.image.replace(/^\//, ''), siteUrl).href,
  // `sameAs` só aceita perfis da MESMA entidade. A ARM Solutions é uma empresa, não outro
  // perfil do Julismo, por isso fica de fora: declará-la aqui seria dizer ao Google que
  // a pessoa e a empresa são a mesma coisa.
  sameAs: profile.links.filter((link) => link.section === 'presence').map((link) => link.href),
};
---

<!doctype html>
<html lang="pt-PT">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#08080a" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="profile" />
    <meta property="og:url" content={siteUrl.href} />
    <meta property="og:site_name" content={profile.fullName} />
    <meta property="og:locale" content="pt_PT" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${profile.name} — ${profile.bio}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="preload" as="image" href={profile.image} />
    <link rel="canonical" href={siteUrl.href} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} is:inline />
  </head>
  <body><slot /></body>
</html>
