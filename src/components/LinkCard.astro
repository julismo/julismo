---
import type { ProfileLink } from '../lib/profile';
import BrandIcon from './BrandIcon.astro';

interface Props {
  link: ProfileLink;
}

const { link } = Astro.props;
const externalAttributes = link.external
  ? { target: '_blank', rel: 'noopener noreferrer' }
  : {};
---

<a
  class:list={['link-card', { 'link-card--primary': link.primary, 'link-card--work': link.section === 'work' }]}
  href={link.href}
  data-link-id={link.id}
  aria-label={`${link.title} — ${link.description}`}
  {...externalAttributes}
>
  <span class:list={['link-card__icon', { 'link-card__icon--arm': link.icon === 'arm' }]}>
    <BrandIcon name={link.icon} />
  </span>
  <span class="link-card__copy">
    <strong>{link.title}</strong>
    <small>{link.description}</small>
  </span>
  <span class="link-card__action" aria-hidden="true">
    <svg class="link-card__action-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path d="M5 12h13m-5-5 5 5-5 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </span>
</a>
