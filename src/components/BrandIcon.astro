{
  name === 'arm' && (
    <span aria-hidden="true" class="brand-icon__arm">ARM</span>
  )
}

{
  name === 'cal' && (
    <svg aria-hidden="true" class="brand-icon__svg" viewBox="0 0 24 24" fill="none">
      <rect x="3.25" y="5.25" width="17.5" height="15.5" rx="3" stroke="currentColor" stroke-width="1.65" />
      <path d="M7.5 3.25v4M16.5 3.25v4M3.25 10h17.5M8 14h.01M12 14h.01M16 14h.01M8 17.5h.01M12 17.5h.01" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" />
    </svg>
  )
}

{
  name === 'email' && (
    <svg aria-hidden="true" class="brand-icon__svg" viewBox="0 0 24 24" fill="none">
      <rect x="3.25" y="5.25" width="17.5" height="13.5" rx="2.25" stroke="currentColor" stroke-width="1.65" />
      <path d="m4.35 7.1 7.04 5.18a1.04 1.04 0 0 0 1.22 0l7.04-5.18" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  )
}

